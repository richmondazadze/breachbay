[Unit]
Description=BreachBay private SpacetimeDB
After=network-online.target
Wants=network-online.target
[Service]
User=breachbaydb
Group=breachbaydb
WorkingDirectory=/var/lib/breachbaydb
ExecStart=/opt/breachbay/runtime/spacetime/spacetimedb-standalone start --listen-addr 127.0.0.1:3001 --data-dir /var/lib/breachbaydb/data --page_pool_max_size 2147483648 --jwt-pub-key-path /var/lib/breachbaydb/public.pem --jwt-priv-key-path /var/lib/breachbaydb/private.pem --non-interactive
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/breachbaydb
[Install]
WantedBy=multi-user.target
